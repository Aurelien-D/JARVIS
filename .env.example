# ============================================================
#  JARVIS Local — configuration
#  1) Copie ce fichier et renomme la copie en ".env"
#  2) Colle ta clé API OpenAI ci-dessous (voir README, étape 3)
# ============================================================

# REQUIS — clé API OpenAI pour la voix temps réel (commence par sk-...)
OPENAI_API_KEY=

# ------------------------------------------------------------
# Optionnel : décommente (enlève le #) pour changer les défauts
# ------------------------------------------------------------

# Modèle vocal temps réel OpenAI
# REALTIME_MODEL=gpt-realtime-2.1

# Voix de JARVIS (ballad = majordome britannique ; autres : ash, echo, verse, cedar, marin)
# JARVIS_VOICE=ballad

# Langue parlée par JARVIS
# JARVIS_LANGUAGE=français

# Dossier où travaillent les sessions Claude Code
# (par défaut : JARVIS-travail dans votre dossier utilisateur, créé au besoin)
# JARVIS_WORKDIR=C:/Users/TonNom/JARVIS-travail

# Durée max d'une tâche Claude Code, en secondes
# JARVIS_TASK_TIMEOUT=600

# Port du serveur local
# JARVIS_PORT=8788

# Mode de permission des sessions Claude Code (elles tournent sans interface :
# ce qui demanderait une autorisation est refusé)
#   auto              = un classifieur laisse passer le sûr et refuse le risqué (défaut)
#   acceptEdits       = fichiers autorisés, commandes shell refusées
#   bypassPermissions = aucun contrôle (déconseillé)
# JARVIS_PERMISSION_MODE=auto

# ------------------------------------------------------------
# Tâches Claude Code
# ------------------------------------------------------------

# Modèle Claude selon la complexité de la tâche (alias : haiku, sonnet, opus ;
# vide = modèle par défaut de ton compte). Si ton abonnement n'a pas accès à un
# modèle, JARVIS réessaie tout seul avec le modèle par défaut.
# JARVIS_MODEL_SIMPLE=haiku
# JARVIS_MODEL_NORMAL=sonnet
# JARVIS_MODEL_COMPLEX=opus

# Connecteurs MCP en plus pour les tâches (mails, agenda, domotique...) :
# chemin d'un fichier JSON au format de Claude Code (voir README)
# JARVIS_MCP_CONFIG=C:/Users/TonNom/jarvis-mcp.json

# ------------------------------------------------------------
# Mains libres et proactivité
# ------------------------------------------------------------

# Mot d'éveil « Jarvis » actif au démarrage (1 = oui, 0 = non ; modifiable dans l'interface)
# JARVIS_WAKE_WORD=1

# Mise en veille après X minutes sans parler (0 = jamais)
# JARVIS_IDLE_MINUTES=3

# Briefing du matin : heure (HH:MM), vide pour le désactiver
# JARVIS_BRIEFING_TIME=08:00

# Ta ville, pour la météo du briefing
# JARVIS_CITY=Paris

# Dossier des données de JARVIS (mémoire, rappels, historique, journal)
# JARVIS_DATA_DIR=C:/Users/TonNom/jarvis-data

# ------------------------------------------------------------
# Session vocale (OpenAI Realtime)
# ------------------------------------------------------------

# Modèle qui transcrit ce que vous dites (affiché à l'écran, gardé pour les reconnexions)
# JARVIS_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Modèle de secours si OpenAI refuse le premier
# JARVIS_TRANSCRIBE_FALLBACK=whisper-1

# Effort de réflexion des modèles gpt-realtime-2.x (low, medium, high)
# JARVIS_REASONING=low

# Réduction de bruit du micro : far_field (micro du PC ou de la webcam) ou near_field (casque)
# JARVIS_NOISE_REDUCTION=far_field

# Prise de parole : auto, ou low si JARVIS vous coupe trop tôt
# JARVIS_EAGERNESS=auto

# Vitesse de la voix (1.0 = normale)
# JARVIS_VOICE_SPEED=1.0

# Durée de validité, en secondes, de la clé temporaire donnée à la page
# JARVIS_SECRET_TTL=120

# Part d'une longue conversation gardée quand elle devient trop longue (0 à 1)
# JARVIS_RETENTION_RATIO=0.8

# ------------------------------------------------------------
# Tâches Claude Code : garde-fous et coûts
# ------------------------------------------------------------

# Plafond de dépense par tâche, en dollars
# JARVIS_TASK_BUDGET_USD=2.0

# Plafond de dépense par jour, en dollars (0 = pas de plafond)
# JARVIS_DAILY_BUDGET_USD=0

# Nombre maximal de tâches Claude Code en même temps
# JARVIS_MAX_CONCURRENT_TASKS=3

# Demander votre confirmation avant une tâche avec accès complet (1 = oui, 0 = non)
# JARVIS_CONFIRM_COMPLET=1

# Délai, en secondes, pour confirmer une action avant qu'elle n'expire
# JARVIS_PENDING_TTL=90

# Sites ouverts sans confirmation, séparés par des virgules (ex. : youtube.com,mail.google.com)
# JARVIS_OPEN_URL_ALLOW=

# Mode sans échec des tâches (auto, on, off)
# JARVIS_SAFE_MODE=auto

# Mode restreint de Claude Code pour le profil recherche (auto, on, off)
# JARVIS_RESTRICTED=auto

# ------------------------------------------------------------
# A.R.E.S (serveur MCP local)
# ------------------------------------------------------------

# Utiliser A.R.E.S : auto (s'il répond), on ou off
# JARVIS_ARES=auto

# Adresse du serveur MCP d'A.R.E.S
# JARVIS_ARES_URL=http://127.0.0.1:6178/mcp

# Nom du serveur A.R.E.S dans la configuration MCP de Claude Code
# JARVIS_ARES_MCP_NAME=ares

# ------------------------------------------------------------
# Proactivité
# ------------------------------------------------------------

# Heures calmes : pas d'annonce à voix haute ni de son (HH:MM-HH:MM)
# JARVIS_QUIET_HOURS=22:30-07:30

# Jours du briefing du matin (ex. : lun-ven, tous)
# JARVIS_BRIEFING_DAYS=lun-ven

# Ajouter les titres de l'actualité au briefing (1 = oui, 0 = non)
# JARVIS_BRIEFING_NEWS=0

# Flux RSS des actualités, séparés par des virgules
# JARVIS_NEWS_FEEDS=https://www.lemonde.fr/rss/une.xml

# Rouvrir la fenêtre de JARVIS quand un rappel arrive (1 = oui, 0 = non)
# JARVIS_REOPEN_ON_REMINDER=1

# Nombre de jours gardés dans le journal des conversations
# JARVIS_JOURNAL_DAYS=30

# ------------------------------------------------------------
# Intégration Windows
# ------------------------------------------------------------

# Raccourci global pour parler à JARVIS depuis n'importe quelle application
# JARVIS_HOTKEY=ctrl+alt+shift+j

# Navigateur de la fenêtre JARVIS : auto, chrome ou edge
# JARVIS_BROWSER=auto

# Icône dans la zone de notification (1 = oui, 0 = non)
# JARVIS_TRAY=1
